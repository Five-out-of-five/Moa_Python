# 실행 환경: local / dev / prod
APP_ENV=local
LOG_LEVEL=INFO

# Spring 과 공유하는 내부 호출 키. 비우면 검사하지 않는다(로컬). prod 는 필수.
INTERNAL_API_KEY=

# Gemini 키. 쉼표로 여러 개 지정하면 429/401/403 때 다음 키로 넘어간다.
GEMINI_API_KEY=
GEMINI_KEY_COOLDOWN_SECONDS=300

# 모델 (비우면 기본값)
# GEMINI_MODEL_TONE=
# GEMINI_MODEL_CONFLICT=
# GEMINI_MODEL_SUMMARY=
# GEMINI_MODEL_COMPROMISE=
# GEMINI_MODEL_LAYOUT=
# GEMINI_MODEL_ASSISTANT=
# GEMINI_MODEL_EMBEDDING=

# 키 없이 Spring 연동만 확인할 때 true. prod 에서는 켤 수 없다.
AI_STUB_MODE=false
