# 실행 환경: local / dev / prod
APP_ENV=local
LOG_LEVEL=INFO

# Spring 과 공유하는 내부 호출 키. 비우면 검사하지 않는다(로컬). prod 는 필수.
INTERNAL_API_KEY=

# Gemini 키. 쉼표로 여러 개 지정하면 429/401/403 때 다음 키로 넘어간다.
GEMINI_API_KEY=
GEMINI_KEY_COOLDOWN_SECONDS=300

# 모델 (비우면 기본값)
# GEMINI_MODEL_TONE=
# GEMINI_MODEL_CONFLICT=
# GEMINI_MODEL_SUMMARY=
# GEMINI_MODEL_COMPROMISE=
# GEMINI_MODEL_LAYOUT=
# GEMINI_MODEL_ASSISTANT=
# GEMINI_MODEL_EMBEDDING=

# 시도 한 번에 기다리는 최대 시간(초). 넘으면 끊고 다시 시도한다. 전체 마감은 25초.
# GEMINI_ATTEMPT_TIMEOUT_SECONDS=12

# 생각 수준: minimal / low / medium / high (비우면 모델 기본값). 기본 low.
# 3.8 Flash·Hydrogen 은 minimal 을 받지 않는다. high 는 25초 마감을 넘기기 쉽다.
# GEMINI_THINKING_TONE=low
# GEMINI_THINKING_CONFLICT=low
# GEMINI_THINKING_SUMMARY=low
# GEMINI_THINKING_COMPROMISE=low
# GEMINI_THINKING_LAYOUT=low
# GEMINI_THINKING_ASSISTANT=low

# 키 없이 Spring 연동만 확인할 때 true. prod 에서는 켤 수 없다.
AI_STUB_MODE=false
